{
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) CyberSecurityNewsAgent/1.0",
  "timeout_seconds": 10,
  "extraction_timeout_seconds": 15,
  "max_retries": 3,
  "min_article_length_chars": 100,
  "max_article_age_hours": 24,
  "content_similarity_threshold": 0.85,
  "gemini_model": "gemini-3.1-flash-lite",
  "max_daily_analysis_limit": 100,
  "respect_robots_txt": true,
  "max_redirects": 5,
  "stale_feed_threshold_hours": 72,
  "display_timezone": "Asia/Dhaka",
  "test_mode": false,
  "test_mode_article_limit": 5,
  "data_dir": "data",
  "log_dir": "logs",
  "reports_dir": "reports",
  "feed_status_file": "data/feed_status.json",
  "raw_articles_file": "data/raw_articles.json",
  "article_content_file": "data/article_content.json",
  "deduplicated_articles_file": "data/deduplicated_articles.json",
  "analyzed_articles_file": "data/analyzed_articles.json",
  "enriched_articles_file": "data/enriched_articles.json",
  "final_articles_file": "data/final_articles.json",
  "nvd_cache_file": "data/nvd_cache.json",
  "kev_catalog_file": "data/kev_catalog.json",
  "run_history_file": "data/run_history.json",
  "report_output_file": "reports/index.html"
}